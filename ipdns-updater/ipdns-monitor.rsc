# IP Collector DNS -- traffic monitor (Up/Down counters per app): AUTO-GENERATED by "DNS Generator/build_updater.py".
# OPTIONAL. Paste into the router's terminal after the IP Collector DNS updater is installed. Safe to paste again.
# The daily updater never adds, changes or removes these rules (they are tagged IPDNS-MON:).
/ip firewall mangle remove [find where comment~"^IPDNS-MON:"]
:do { [[:parse "/ipv6 firewall mangle remove [find where comment~\"^IPDNS-MON:\"]"]] } on-error={}
/ip firewall mangle add action=passthrough chain=prerouting comment="IPDNS-MON: SpeedTest Traffic Down" src-address-list="SpeedTest IPs"
